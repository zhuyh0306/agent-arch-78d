{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataagent.local/specs/anomaly.schema.json",
  "title": "AnomalyContract v1",
  "description": "异常类任务：哪些点偏离了基线、偏离多少、判定依据是什么。阈值必须来自基线而不是拍脑袋。",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1"
    },
    "task_type": {
      "const": "anomaly"
    },
    "metric": {
      "$ref": "common.schema.json#/$defs/MetricId"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "description": "与指标字典的 unit 一致"
    },
    "window": {
      "$ref": "common.schema.json#/$defs/TimeWindow"
    },
    "granularity": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "month"
      ]
    },
    "baseline": {
      "type": "object",
      "description": "基线来源。没有基线的异常检测等于随便划线",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "same_period_last_year",
            "trailing_mean",
            "trailing_median",
            "holiday_adjusted"
          ]
        },
        "lookback_days": {
          "type": "integer",
          "minimum": 7,
          "maximum": 730,
          "description": "trailing_* 回溯天数；同比类填与窗口等长"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "lookback_days"
      ],
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "zscore",
            "mad",
            "iqr",
            "stl_residual"
          ]
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "触发阈值的实际数值，不同 kind 单位不同，必须写出来而不是只写 kind"
        },
        "sensitivity_note": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "threshold"
      ],
      "additionalProperties": false
    },
    "anomalies": {
      "type": "array",
      "description": "命中的异常点，可以为空数组（没发现异常也是结论）",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "value": {
            "type": "number"
          },
          "baseline_value": {
            "type": "number"
          },
          "deviation": {
            "type": "number",
            "description": "value - baseline_value，绝对值口径"
          },
          "score": {
            "type": "number",
            "description": "按 method.kind 算出的原始分数（z / mad / iqr 倍数）"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "common.schema.json#/$defs/Evidence"
            }
          }
        },
        "required": [
          "period",
          "value",
          "baseline_value",
          "deviation",
          "score",
          "severity",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "anomaly_found",
        "no_anomaly",
        "insufficient_data"
      ],
      "description": "「没发现异常」必须是显式结论，不能靠空数组让调用方自己猜"
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "common.schema.json#/$defs/Evidence"
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "min_baseline_points": {
          "type": "integer",
          "minimum": 7,
          "description": "基线样本少于该值即 INSUFFICIENT_DATA"
        },
        "baseline_excludes_window": {
          "const": true,
          "description": "基线不得包含被检测窗口，否则异常会被自己拉平"
        },
        "threshold_from_baseline": {
          "const": true,
          "description": "阈值必须由基线分布推出，不允许写死一个好看的数字"
        },
        "max_anomalies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "min_baseline_points",
        "baseline_excludes_window",
        "threshold_from_baseline",
        "max_anomalies"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "task_type",
    "metric",
    "unit",
    "window",
    "granularity",
    "baseline",
    "method",
    "anomalies",
    "conclusion",
    "verdict",
    "evidence",
    "constraints"
  ],
  "additionalProperties": false,
  "$comment": "conclusion 与 anomalies 是否自洽（anomaly_found 必须有条目，空数组必须是 no_anomaly）、severity 与 score 是否矛盾，由 contract_rules.py 校验。"
}
