{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataagent.local/specs/trend.schema.json",
  "title": "TrendContract v1",
  "description": "趋势类任务：一段时间的走向与拐点。趋势必须给点列与拟合质量，只给一句「在涨」不算趋势。",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1"
    },
    "task_type": {
      "const": "trend"
    },
    "metric": {
      "$ref": "common.schema.json#/$defs/MetricId"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "description": "与指标字典的 unit 一致"
    },
    "window": {
      "$ref": "common.schema.json#/$defs/TimeWindow"
    },
    "granularity": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "month"
      ],
      "description": "点的粒度；周口径必须说明是从周一起还是周日起，见 constraints.week_start"
    },
    "points": {
      "type": "array",
      "description": "按时间升序的点列，不能跳点也不能补 0 冒充有点",
      "minItems": 3,
      "maxItems": 400,
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
            "description": "该粒度下的起始日，YYYY-MM-DD"
          },
          "value": {
            "type": "number"
          },
          "is_complete": {
            "type": "boolean",
            "description": "该期是否已结束；未结束的当期必须 false，否则最后一个点会被误读为下跌"
          }
        },
        "required": [
          "period",
          "value",
          "is_complete"
        ],
        "additionalProperties": false
      }
    },
    "direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "flat",
        "volatile"
      ],
      "description": "volatile 表示无显著单调方向，不允许硬说成 up 或 down"
    },
    "period_change": {
      "type": "object",
      "description": "期初到期末的变化，用首尾完整点算，不用未完成点",
      "properties": {
        "absolute": {
          "type": "number"
        },
        "relative": {
          "type": [
            "number",
            "null"
          ],
          "description": "首点为 0 时必须 null"
        }
      },
      "required": [
        "absolute",
        "relative"
      ],
      "additionalProperties": false
    },
    "fit": {
      "type": "object",
      "description": "拟合质量。没有 r2 的趋势线只是画线",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "ols",
            "holt_winters",
            "theil_sen"
          ]
        },
        "r2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "theil_sen 等非最小二乘方法可为 null，但要在 note 说明"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "method",
        "r2"
      ],
      "additionalProperties": false
    },
    "change_points": {
      "type": "array",
      "description": "拐点，可以没有",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "level_shift",
              "slope_change"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "common.schema.json#/$defs/Evidence"
            }
          }
        },
        "required": [
          "period",
          "kind",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "common.schema.json#/$defs/Evidence"
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "min_points": {
          "type": "integer",
          "minimum": 3,
          "description": "少于 3 个点不足以谈趋势，低于即 INSUFFICIENT_DATA"
        },
        "week_start": {
          "type": "string",
          "enum": [
            "monday",
            "sunday"
          ],
          "description": "周粒度起始日，必须写死一个而不是各报表各用一套"
        },
        "exclude_incomplete_period": {
          "const": true,
          "description": "direction / period_change 不得把 is_complete=false 的点纳入计算"
        },
        "max_points": {
          "type": "integer",
          "minimum": 3,
          "maximum": 400
        }
      },
      "required": [
        "min_points",
        "week_start",
        "exclude_incomplete_period",
        "max_points"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "task_type",
    "metric",
    "unit",
    "window",
    "granularity",
    "points",
    "direction",
    "period_change",
    "fit",
    "change_points",
    "verdict",
    "evidence",
    "constraints"
  ],
  "additionalProperties": false,
  "$comment": "period_change 与首尾点的一致性、未完成点是否被排除、方向与斜率是否一致，由 contract_rules.py 校验。"
}
